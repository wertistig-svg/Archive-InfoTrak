{% extends 'base.html.twig' %}

{% block title %}{{ article.displayTitle }} — InfoTrak{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/infotrak.css') }}" />
{% endblock %}

{% block javascripts %}
    {{ importmap(['app', 'infotrak']) }}
{% endblock %}

{% block body %}
<main id="top" class="article-page">
  <div class="x-topbar">
    <a class="back-btn article-back-link" href="{{ path('app_home') }}" aria-label="Retour au fil d’actualités"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12H4m6-6-6 6 6 6"/></svg><span>Retour au fil</span></a>
    <strong>InfoTrak.re <span class="beta-tag">BÊTA</span></strong>
  </div>

  <article class="x-post">
    <div class="x-head">
      <span class="avatar x-avatar">{{ article.source.name|slice(0, 1) }}{% if article.publisherLogo %}<img class="favicon publisher-logo" src="{{ article.publisherLogo }}" alt="{{ article.source.name }}">{% elseif article.sourceHost %}<img class="favicon" src="https://www.google.com/s2/favicons?domain={{ article.sourceHost }}&sz=128" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()" />{% endif %}</span>
      <div>
        <strong>{{ article.source.name }}</strong><br />
        <small class="x-handle">{{ article.place }}{% if article.category != article.place %} · {{ article.category }}{% endif %}</small>
      </div>
    </div>

    <h1 class="x-title">{{ article.displayTitle }}</h1>
    {% include 'components/_article_metadata.html.twig' %}
    {% if article.demo %}<p class="demo-notice">Exemple de démonstration : ce contenu sert aux tests et ne constitue pas une actualité vérifiée.</p>{% endif %}
    <section class="article-brief" aria-label="L’essentiel">
      <p class="brief-label">L’ESSENTIEL</p>
      {% if article.readingSummary %}<p class="x-text">{{ article.readingSummary }}</p><p class="brief-attribution">Extrait condensé de {{ article.source.name }}.</p>
      {% else %}<p class="x-text summary-unavailable">InfoTrak n’a pas encore récupéré de résumé détaillé pour cet article. Les informations restent accessibles chez {{ article.source.name }}.</p>{% endif %}
      {% if article.sourceUrl %}<a class="article-original" href="{{ article.sourceUrl }}" target="_blank" rel="noopener noreferrer">Lire l’article complet chez {{ article.source.name }} ↗</a>{% endif %}
    </section>

    {% if article.hasImage %}
    <figure class="x-media">
      <img src="{{ article.imageUrl }}" alt="Illustration associée à l’article de {{ article.source.name }}" loading="lazy" referrerpolicy="no-referrer" />
      <figcaption><small>Image : {{ article.source.name }}</small></figcaption>
    </figure>
    {% endif %}

    {% set embed = video_embed(article.videoUrl) %}
    {% if embed %}
      {% include 'components/_video_player.html.twig' with {url: article.videoUrl, title: article.title, mode: 'full'} %}
    {% endif %}

    <div class="x-actions" data-xbar data-article="{{ article.id }}">
      <button data-x="share" aria-label="Partager"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3v12m0-12 4 4m-4-4L8 7M5 11v8h14v-8"/></svg><span>Partager</span></button>
      <button data-x="like" aria-label="J'aime" class="{{ userLiked ? 'active' : '' }}"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.7-7.5 1.1-1.1a5.5 5.5 0 0 0 0-7.8Z"/></svg><span id="likesCount">{{ likesCount }}</span></button>
      <span aria-label="{{ article.viewCount }} vues"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>{{ article.viewCount }} vue{{ article.viewCount > 1 ? 's' }}</span>
    </div>

    <p class="x-foot">
      <span class="trust-label">{{ article.trustLabel }}</span>
    </p>
  </article>

  <div class="source-trust">
    <div style="flex:1;min-width:0"><strong>{{ article.source.name }}</strong><p>La source est indiquée pour vous permettre de vérifier le contexte. Un lien retrouvé ou un flux de presse ne garantit pas l’exactitude des faits.</p></div>
  </div>

  {% if related|length > 0 %}
  <h2 style="margin-top:28px">À lire aussi</h2>
  <div class="related-list">
    {% for r in related %}
    <a href="{{ path('app_article_show', {slug: r.slug}) }}">{{ r.displayTitle }}<small>{{ r.source.name }} · {{ r.publishedAt|date('d/m H:i') }}</small></a>
    {% endfor %}
  </div>
  {% endif %}
</main>
<div class="toast" id="toast" role="status"></div>
{% endblock %}
