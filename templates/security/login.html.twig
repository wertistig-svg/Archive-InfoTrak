{% extends 'base.html.twig' %}

{% block title %}Connexion — InfoTrak{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/infotrak.css') }}" />
{% endblock %}

{% block javascripts %}{% endblock %}

{% block body %}
<main class="login-page">
  <div class="login-preview" id="loginPreview" aria-hidden="true" inert>
    <div class="login-preview-bar"><span class="brand-mark"><i></i><i></i><i></i></span><span>InfoTrak<small>.re</small></span><span class="login-preview-search"></span></div>
    <div class="login-preview-grid">
      {% for a in previewArticles %}
      <article class="login-preview-card">
        <p class="eyebrow"><span></span> {{ a.category|upper }}</p>
        <h3>{{ a.title }}</h3>
        <p>{{ a.excerpt|slice(0, 120) }}…</p>
        <small>{{ a.source.name }} · {{ a.publishedAt|date('d/m H:i') }} · {{ a.trustLabel }}</small>
      </article>
      {% endfor %}
    </div>
  </div>
  <div class="login-card">
    <a class="brand login-brand" href="{{ path('app_login') }}" aria-label="InfoTrak, accueil">
      <span class="brand-mark"><i></i><i></i><i></i></span>
      <span>Info<span>Trak</span><small>.re</small></span>
    </a>
    <h1>Bienvenue</h1>
    <p class="date-copy">Retrouvez vos préférences sur vos appareils et recevez vos alertes dans votre espace personnel.</p>
    <p><a class="source-link" href="{{ path('app_home') }}">Continuer sans compte →</a></p>

    {% for message in app.flashes('error') %}
      <p class="login-error" role="alert">{{ message }}</p>
    {% endfor %}
    {% if lastError %}
      <p class="login-error" role="alert">Connexion impossible : {{ lastError.messageKey|trans(lastError.messageData, 'security') }}</p>
    {% endif %}
    {% if not googleConfigured %}
      <p class="login-error" role="alert">La connexion Google sera bientôt disponible. Vous pouvez déjà explorer les actualités sans compte.</p>
    {% endif %}

    {% if googleConfigured %}
    <a class="google-btn" href="{{ path('connect_google') }}">
      <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3l5.7-5.7C34.3 6.1 29.4 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.7-.4-3.9z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3l5.7-5.7C34.3 6.1 29.4 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C36.9 39.2 44 34 44 24c0-1.3-.1-2.7-.4-3.9z"/></svg>
      Continuer avec Google
    </a>
    {% else %}
    <span class="google-btn google-btn-disabled" aria-disabled="true">
      <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3l5.7-5.7C34.3 6.1 29.4 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.7-.4-3.9z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3l5.7-5.7C34.3 6.1 29.4 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C36.9 39.2 44 34 44 24c0-1.3-.1-2.7-.4-3.9z"/></svg>
      Continuer avec Google
    </span>
    {% endif %}
    <p class="login-hint"><small>Nous utilisons uniquement votre nom, e-mail et photo pour créer votre espace personnel.</small></p>
  </div>
</main>
<div class="toast" id="toast" role="status"></div>
{% endblock %}
